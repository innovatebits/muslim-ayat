# Supabase public client configuration. Never put a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Set this to the deployed origin in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags: omit or set true to enable; set false to disable.
# Core Quran reading and Arabic text are intentionally always available.
NEXT_PUBLIC_FEATURE_TRANSLATIONS=true
NEXT_PUBLIC_FEATURE_MUSHAF_LAYOUT=true
NEXT_PUBLIC_FEATURE_SURAH_HEADERS=true
NEXT_PUBLIC_FEATURE_TRANSLITERATION=true
NEXT_PUBLIC_FEATURE_TAFSIR=true
NEXT_PUBLIC_FEATURE_WORD_BY_WORD=true
NEXT_PUBLIC_FEATURE_SEARCH=true
NEXT_PUBLIC_FEATURE_AUDIO=true
NEXT_PUBLIC_FEATURE_OFFLINE=true
NEXT_PUBLIC_FEATURE_BOOKMARKS=true
NEXT_PUBLIC_FEATURE_NOTES=true
NEXT_PUBLIC_FEATURE_READING_PROGRESS=true
NEXT_PUBLIC_FEATURE_READER_PREFERENCES=true
NEXT_PUBLIC_FEATURE_ACCOUNT_PROFILE=true

# Authentication methods and providers.
NEXT_PUBLIC_FEATURE_AUTH_EMAIL_PASSWORD=true
NEXT_PUBLIC_FEATURE_AUTH_PASSWORD_RESET=true
NEXT_PUBLIC_FEATURE_AUTH_EMAIL_OTP=true
NEXT_PUBLIC_FEATURE_AUTH_MAGIC_LINK=true
NEXT_PUBLIC_FEATURE_AUTH_GOOGLE=true
NEXT_PUBLIC_FEATURE_AUTH_MICROSOFT=true
NEXT_PUBLIC_FEATURE_AUTH_FACEBOOK=true
